# === 敏感信息（必须忽略） ===
# API 密钥存储文件
.api-keys.json

# URL 历史记录（可能包含敏感端点地址）
.url-history.json

# 环境变量文件
.env
.env.*

# === 运行时产物 ===
# 日志文件
logs/
*.log
*.log.1

# Edge 独立窗口的浏览器数据
.edge-profile/

# 用量限额数据
.quota-data.json

# 编译产物
CopilotModelManager.exe
CopilotModelManager.tmp

# Node.js 依赖
node_modules/

# === 操作系统 ===
.DS_Store
Thumbs.db
desktop.ini

# === 编辑器 ===
.vscode/
*.swp
*.swo
*~
